---
import Layout from "../../layouts/Layout.astro";
import Atlas from "../../components/Atlas";
export function getStaticPaths() {
  return ["pl", "en"].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as "pl" | "en";
---

<Layout lang={lang}><Atlas lang={lang} client:load /></Layout>
